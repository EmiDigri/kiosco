const { getPvpSepa } = require('./sepaPvp');

function normalize(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function money(n) {
  if (n === null || n === undefined || Number.isNaN(Number(n))) return null;
  return '$' + Math.round(Number(n)).toLocaleString('es-AR');
}

