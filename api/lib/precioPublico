function score(ref, q) {
  const nq = normalize(q);
  if (!nq) return 0;
  const nt = normalize(ref.title);
  if (nt === nq) return 100;
  if (nt.includes(nq) || nq.includes(nt)) return 90;
  let s = 0;
  for (const key of ref.keys || []) {
    const nk = normalize(key);
    if (!nk) continue;
    if (nq.includes(nk) || nk.includes(nq)) s = Math.max(s, 80);
    const terms = nk.split(' ').filter(Boolean);
    const hits = terms.filter(t => nq.includes(t)).length;
    if (hits) s = Math.max(s, hits * 14);
  }
  const qTerms = nq.split(' ').filter(Boolean);
  const hay = normalize([ref.title, ...(ref.keys || [])].join(' '));
  const hits = qTerms.filter(t => hay.includes(t)).length;
  if (hits) s = Math.max(s, hits * 12);
  return s;
}

// Catálogo manual viejo. Se mantiene como función separada (antes era todo
// lo que hacía getPublicReference) para poder usarlo como fallback.
function getManualReference(q) {
  const ranked = PUBLIC_REFERENCES
    .map(ref => ({ ...ref, score: score(ref, q) }))
    .filter(ref => ref.score > 0)
    .sort((a, b) => b.score - a.score);

  const ref = ranked[0] || null;
  if (!ref) {
    return {
      found: false,
      title: String(q || '').trim(),
      publicPrice: null,
      publicPriceText: null,
      source: 'No disponible todavía',
      type: 'sin_referencia'
    };
  }

  return {
    found: ref.publicPrice !== null && ref.publicPrice !== undefined,
    id: ref.id,
    title: ref.title,
    publicPrice: ref.publicPrice,
    publicPriceText: money(ref.publicPrice),
    source: ref.source,
    type: ref.publicPrice === null || ref.publicPrice === undefined ? 'sin_precio' : 'referencia_inicial',
    updatedAt: 'Referencia inicial editable',
    score: ref.score
  };
}

// Función principal — AHORA ES ASYNC.
// 1) Intenta SEPA (Coto + Día real, actualizado a diario).
// 2) Si SEPA no devuelve nada confiable, usa el catálogo manual de respaldo.
async function getPublicReference(q) {
  const texto = String(q || '').trim();
  if (!texto) {
    return {
      found: false,
      title: '',
      publicPrice: null,
      publicPriceText: null,
      source: 'No disponible todavía',
      type: 'sin_referencia'
    };
  }

  try {
    const sepa = await getPvpSepa(texto);
    if (sepa && sepa.found && sepa.publicPrice) {
      return {
        found: true,
        title: sepa.nombreOficial || texto,
        publicPrice: sepa.publicPrice,
        publicPriceText: sepa.publicPriceText,
        source: sepa.source,
        type: 'sepa_promedio_coto_dia',
        updatedAt: 'Actualizado a diario (SEPA)',
        detalle: sepa.detalle
      };
    }
  } catch (err) {
    console.warn('SEPA falló, usando catálogo manual para "' + texto + '":', err && err.message || err);
  }

  // Fallback: catálogo manual viejo.
  return getManualReference(texto);
}

module.exports = { PUBLIC_REFERENCES, getPublicReference, getManualReference, normalize, money };
